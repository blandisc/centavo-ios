<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The launch screen is the app's own background (Theme.background), not black. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- The shared Keychain group for the widgets' snapshot (WidgetSnapshotStore). -->
	<key>CentavoKeychainGroup</key>
	<string>$(AppIdentifierPrefix)com.blandisc.centavo.shared</string>
	<!-- «audio»: the floating setup guide (Picture in Picture) needs it to float over Atajos; the
	     app plays no sound. «remote-notification»: iCloud's silent pushes that sync in the
	     background. Here and not as INFOPLIST_KEY_UIBackgroundModes in project.yml: that key was
	     silently left out of the built app (found 2026-10-29). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
	</array>
	<!-- centavo://anotar and centavo://presupuesto, from the widgets. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.blandisc.centavo</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>centavo</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
