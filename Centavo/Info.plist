<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The launch screen is the app's own background (Theme.background), not black. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- The shared Keychain group for the widgets' snapshot (WidgetSnapshotStore). -->
	<key>CentavoKeychainGroup</key>
	<string>$(AppIdentifierPrefix)com.blandisc.centavo.shared</string>
	<!-- centavo://anotar and centavo://presupuesto, from the widgets. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.blandisc.centavo</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>centavo</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
